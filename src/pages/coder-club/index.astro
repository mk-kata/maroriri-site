---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PriceBlock from "../../components/PriceBlock.astro";
import ServiceFlow from "../../components/ServiceFlow.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import CTASection from "../../components/CTASection.astro";
import { coderClub } from "../../data/services";
import { faqCategories } from "../../data/faq";

const icons: Record<string, string> = {
	book: '<path d="M4 5.5C4 4.67 4.67 4 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13Z"/><path d="M20 5.5C20 4.67 19.33 4 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5v-13Z"/>',
	people: '<circle cx="8.5" cy="8" r="3"/><circle cx="16" cy="9.5" r="2.3"/><path d="M3.5 20c.4-3.5 2.6-5.5 5-5.5s4.6 2 5 5.5"/><path d="M14.5 15.3c2 .2 3.6 1.7 4 4.7"/>',
	chat: '<rect x="4" y="5" width="16" height="10" rx="2"/><path d="M9 15v4l-2.5-4"/>',
	apply: '<path d="M12 3.5v10.5"/><path d="m7.5 10 4.5 4.5L16.5 10"/><path d="M4.5 18.5h15"/>',
};

const activities = [
	{
		tag: "LEARN",
		title: "月1回のオンライン勉強会",
		body: "HTMLの意味や文章構造、デザインの読み取り方、案件の進め方、クライアントへの伝え方などを扱います。",
		icon: "book",
	},
	{
		tag: "THINK",
		title: "問題を持ち寄るコミュニティ",
		body: "実務で困ったことや迷ったことを共有し、ほかの制作者の考え方にも触れながら、自分の判断基準を整理します。",
		icon: "people",
	},
	{
		tag: "TALK",
		title: "月1回・60分の個別相談",
		body: "実案件、仕事、クライアントとの関係、仕事の獲得、キャリアについて個別に相談できます。",
		icon: "chat",
	},
	{
		tag: "APPLY",
		title: "学びを、実案件に持ち帰る",
		body: "勉強会や相談で得た考え方を、目の前の案件でどう使うかまで整理します。知識を聞いて終わらせず、自分で判断し、仕事の中で活かせる状態を目指します。",
		icon: "apply",
	},
];

const whoItsFor = [
	"実案件について相談できる相手がいない",
	"ほかの制作者の考え方を知りたい",
	"HTMLの構造に自信が持てない",
	"仕事の進め方に迷っている",
	"クライアントへの伝え方を学びたい",
	"自分の価値や強みを整理したい",
	"これからのキャリアを考えたい",
];

const flowSteps = [
	{ num: "01", title: "公式LINEを友だち追加" },
	{ num: "02", title: "「コーダー部」と送信" },
	{ num: "03", title: "参加条件と利用方法の案内を確認" },
	{ num: "04", title: "申込み手続き" },
	{ num: "05", title: "コーダー部へ参加" },
];

const included = [
	"月額3,300円（税込）",
	"月1回のオンライン勉強会",
	"月1回60分の個別相談",
	"問題を持ち寄るコミュニティ",
	"会員向けデザイン料理教室",
];

const pending = [
	"決済方法",
	"入会日と課金日",
	"退会期限",
	"勉強会のアーカイブ",
	"コミュニティで使用するツール",
	"キャンセル、返金条件",
];

const faqItems = faqCategories.find((c) => c.id === "coder-club")!.items;
---

<BaseLayout title="マロリリコーダー部｜MARORIRI" description="マロリリコーダー部は、コーダー・Web制作者が実務の疑問や迷いを持ち寄り、制作者としての判断基準を育てる月額制のコミュニティです。">
	<PageHero eyebrow="MARORIRI CODER CLUB" crumbLabel="マロリリコーダー部">
		ひとりで正解を探すのではなく、<br />考え方を持ち寄り、自分の基準を育てる。
		<Fragment slot="lede">
			<p>
				マロリリコーダー部は、コーダー・Web制作者が実務の疑問や迷いを持ち寄り、<br />
				制作者としての判断基準を育てる月額制のコミュニティです。
			</p>
		</Fragment>
	</PageHero>

	<section class="section section--white club-about">
		<div class="container">
			<SectionHeading eyebrow="ABOUT THE CLUB">完成したコードだけでなく、<br />そこに至るまでの考え方を共有する。</SectionHeading>
			<div class="club-about__body">
				<p>マロリリコーダー部では、一つの正解を教えて終わるのではなく、なぜその方法を選ぶのかをメンバー同士で考えます。</p>
				<p>実案件の疑問、クライアントとのやり取り、工数や納期、今後の働き方まで、コードだけでは解決できないテーマを扱います。</p>
			</div>
		</div>
	</section>

	<section class="section club-fee">
		<div class="container">
			<p class="eyebrow reveal-heading">MONTHLY FEE</p>
			<p class="club-fee__price">{coderClub.monthlyFee}</p>
			<div class="club-fee__pricewrap">
				<PriceBlock items={[{ label: "月額料金", value: coderClub.monthlyFee }]} note={coderClub.feeNote} />
			</div>
		</div>
	</section>

	<section class="section section--dark club-activities">
		<div class="container">
			<p class="eyebrow reveal-heading">CLUB ACTIVITIES</p>
			<h2 class="club-activities__heading reveal-heading">4つの活動</h2>
			<ul class="club-activities__list">
				{
					activities.map((a) => (
						<li class="club-activities__item">
							<span class="icon-badge">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[a.icon]} />
							</span>
							<span class="eyebrow">{a.tag}</span>
							<h3>{a.title}</h3>
							<p>{a.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section section--white club-cooking">
		<div class="container">
			<SectionHeading eyebrow="DESIGN COOKING CLASS">デザインデータを、<br />実装できるHTML構造へ料理する。</SectionHeading>
			<div class="club-cooking__body">
				<p>デザイン料理教室では、ひとつのデザインデータを題材に、見出し階層、リスト、文章のまとまり、情報を読む順番を確認します。</p>
				<p>完成したコードだけを見るのではなく、どのようにデザインを読み取り、どのHTML要素を選んだのかという実装までの思考過程を共有します。</p>
				<p class="club-cooking__note">デザイン料理教室は、マロリリコーダー部会員向けの勉強会です。</p>
			</div>
		</div>
	</section>

	<section class="section club-past">
		<div class="container">
			<p class="eyebrow reveal-heading">PAST ACTIVITY</p>
			<h2 class="club-past__heading reveal-heading">コーダーによるデザイン料理教室</h2>
			<div class="club-past__body">
				<p>
					ひとつのデザインを題材に、見出し階層やリスト、文章のまとまりをどう読み取り、どのようなHTMLへ落とし込むかをZoomで解説しました。
				</p>
				<p>「この見た目を、どの構造で実装するか」という、正解が一つではない問いを参加者の皆さんと一緒に考えたオンライン企画です。</p>
			</div>
			<dl class="club-past__meta">
				<div><dt>開催日</dt><dd>2025年8月28日</dd></div>
				<div><dt>形式</dt><dd>Zoomによるオンライン企画</dd></div>
				<div><dt>参加</dt><dd>約60名が参加</dd></div>
			</dl>
			<p class="club-past__disclaimer">
				※ 約60名は、過去のオンライン企画への参加人数です。コーダー部の会員数ではありません。
			</p>
		</div>
	</section>

	<section class="section section--white club-who">
		<div class="container">
			<SectionHeading eyebrow="WHO IT'S FOR">ひとりで考え続けることに、<br />限界を感じている制作者へ。</SectionHeading>
			<ul class="list-plain club-who__list">
				{whoItsFor.map((t) => <li>{t}</li>)}
			</ul>
		</div>
	</section>

	<section class="section club-flow">
		<div class="container">
			<p class="eyebrow reveal-heading">HOW TO JOIN</p>
			<h2 class="club-flow__heading reveal-heading">参加までの流れ</h2>
			<div class="club-flow__wrap">
				<ServiceFlow steps={flowSteps} />
			</div>
		</div>
	</section>

	<section class="section section--white club-terms">
		<div class="container club-terms__grid">
			<div>
				<p class="eyebrow reveal-heading">WHAT'S INCLUDED</p>
				<h2 class="club-terms__heading reveal-heading">料金と利用条件</h2>
				<ul class="list-plain club-terms__list">
					{included.map((t) => <li>{t}</li>)}
				</ul>
			</div>
			<div class="club-terms__pending">
				<p class="club-terms__pending-label num-mono">現在調整中の項目</p>
				<ul>
					{pending.map((t) => <li>{t}</li>)}
				</ul>
				<p class="club-terms__pending-note">正式に決まり次第、このページでお知らせします。</p>
			</div>
		</div>
	</section>

	<section class="section club-faq">
		<div class="container club-faq__grid">
			<div class="club-faq__head">
				<p class="eyebrow reveal-heading">FAQ</p>
				<h2 class="reveal-heading">コーダー部に<br />よくいただく質問。</h2>
				<ArrowLink href="/faq/">よくある質問をすべて見る</ArrowLink>
			</div>
			<div class="club-faq__list">
				<FaqAccordion items={faqItems} />
			</div>
		</div>
	</section>

	<CTASection
		primaryLabel="公式LINEでコーダー部について相談する"
		primaryHref="/contact/#coder-club"
	>
		考え方を持ち寄り、<br />仕事の中で使える基準を育てる。
	</CTASection>
</BaseLayout>

<style>
	.club-about__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.club-fee__price {
		margin-top: 16px;
		font-family: var(--font-en);
		font-weight: 700;
		font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
	}

	.club-fee__pricewrap {
		margin-top: 32px;
		max-width: 30em;
	}

	.club-activities__heading {
		margin-top: 16px;
		font-size: clamp(1.6rem, 1.2rem + 2.4vw, 2.4rem);
	}

	.club-activities__list {
		margin-top: 48px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.club-activities__item {
		padding: 24px;
		border: 1px solid var(--color-border-dark);
		border-radius: var(--radius-md);
	}

	.club-activities__item .eyebrow {
		display: block;
		margin-top: 16px;
	}

	.club-activities__item h3 {
		margin-top: 10px;
		font-size: 1.1rem;
	}

	.club-activities__item p {
		margin-top: 10px;
		opacity: 0.75;
		font-size: 0.92rem;
	}

	.club-cooking__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.club-cooking__note {
		margin-top: 8px;
		padding-top: 16px;
		border-top: 1px solid var(--color-border);
		font-size: 0.9rem;
		opacity: 0.65;
	}

	.club-past__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.club-past__body {
		margin-top: 24px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.club-past__meta {
		margin-top: 32px;
		display: flex;
		flex-wrap: wrap;
		gap: 24px 48px;
		padding: 24px 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.club-past__meta dt {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		opacity: 0.6;
	}

	.club-past__meta dd {
		margin: 6px 0 0;
		font-size: 1rem;
		font-weight: 500;
	}

	.club-past__disclaimer {
		margin-top: 16px;
		font-size: 0.82rem;
		opacity: 0.6;
	}

	.club-flow__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.club-flow__wrap {
		margin-top: 40px;
	}

	.club-terms__grid {
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	.club-terms__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.club-terms__list {
		margin-top: 32px;
	}

	.club-terms__pending {
		padding: 24px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	.club-terms__pending-label {
		font-size: 0.8rem;
		color: var(--color-accent);
	}

	.club-terms__pending ul {
		margin-top: 16px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 0.9rem;
		opacity: 0.75;
	}

	.club-terms__pending-note {
		margin-top: 16px;
		padding-top: 16px;
		border-top: 1px solid var(--color-border);
		font-size: 0.8rem;
		opacity: 0.6;
	}

	.club-faq__grid {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.club-faq__head h2 {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.club-faq__head :global(.arrow-link) {
		margin-top: 24px;
	}

	@media (min-width: 768px) {
		.club-activities__list {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.club-activities__item {
			flex: 1 1 calc(50% - 8px);
		}

		.club-terms__grid {
			flex-direction: row;
			gap: 64px;
		}

		.club-terms__grid > div:first-child {
			flex: 1.4;
		}

		.club-terms__pending {
			flex: 1;
			align-self: flex-start;
		}
	}

	@media (min-width: 1024px) {
		.club-faq__grid {
			flex-direction: row;
			gap: 80px;
		}

		.club-faq__head {
			flex: 0 0 320px;
		}

		.club-faq__list {
			flex: 1;
			max-width: 720px;
		}
	}
</style>
