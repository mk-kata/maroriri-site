---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PriceBlock from "../../components/PriceBlock.astro";
import ServiceFlow from "../../components/ServiceFlow.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import CTASection from "../../components/CTASection.astro";
import { consulting } from "../../data/services";
import { faqCategories } from "../../data/faq";

const topics = [
	"案件の進め方",
	"工数の考え方",
	"納期の伝え方",
	"修正範囲",
	"クライアントとのやり取り",
	"見積りや提案",
	"自分の価値の伝え方",
	"仕事を獲得するためのアプローチ",
	"今後のキャリア",
	"AI時代の働き方",
	"実案件で迷っていること",
];

const prep = [
	"現在困っていること",
	"関係する資料やURL",
	"これまでの経緯",
	"相談後に決めたいこと",
];

const flowSteps = [
	{ num: "01", title: "公式LINEを友だち追加" },
	{ num: "02", title: "「個別相談」と送信" },
	{ num: "03", title: "相談したい内容を簡単に共有" },
	{ num: "04", title: "日程を調整" },
	{ num: "05", title: "オンライン相談" },
	{ num: "06", title: "次に行うことを整理" },
];

const notes = [
	"法律、税務、医療などの専門相談ではない",
	"売上、受注、採用などの結果を保証しない",
	"制作作業は料金に含まれない",
	"資料作成や追加調査が必要な場合は別途案内",
	"録音、録画の扱いは事前確認とする",
];

const faqItems = faqCategories.find((c) => c.id === "consulting")!.items;
---

<BaseLayout title="実務・キャリア相談｜MARORIRI" description="実務・キャリア相談は、案件の進め方、工数、納期、修正、クライアントとの関係、仕事の獲得、今後のキャリアについて個別に相談できるサービスです。">
	<PageHero eyebrow="1ON1 CONSULTING" crumbLabel="実務・キャリア相談">
		仕事の迷いを言葉にし、<br />次に取る行動を整理する。
		<Fragment slot="lede">
			<p>
				案件の進め方、工数、納期、修正、クライアントとの関係、<br />
				仕事の獲得、今後のキャリアについて個別に相談できます。
			</p>
		</Fragment>
	</PageHero>

	<section class="section section--white con-topics">
		<div class="container">
			<SectionHeading eyebrow="WHAT YOU CAN ASK">相談できる内容</SectionHeading>
			<ul class="tag-list con-topics__list">
				{topics.map((t) => <li>{t}</li>)}
			</ul>
		</div>
	</section>

	<section class="section con-flow-talk">
		<div class="container">
			<SectionHeading eyebrow="TALK AND ORGANIZE">答えを一方的に渡すのではなく、<br />状況を一緒に整理します。</SectionHeading>
			<div class="con-flow-talk__body">
				<p>相談内容をお聞きし、現在の状況、困っていること、選択肢、次に確認することを整理します。</p>
				<p>未来や結果を断定するのではなく、相談者自身が判断できる状態を目指します。</p>
			</div>
		</div>
	</section>

	<section class="section section--white con-price">
		<div class="container">
			<p class="eyebrow reveal-heading">PRICE</p>
			<h2 class="con-price__heading reveal-heading">料金</h2>
			<div class="con-price__wrap">
				<PriceBlock items={[{ label: consulting.duration, value: consulting.price }]} />
			</div>
			<p class="con-price__note">{consulting.memberNote}</p>
		</div>
	</section>

	<section class="section con-prep">
		<div class="container">
			<p class="eyebrow reveal-heading">BEFORE YOU TALK</p>
			<h2 class="con-prep__heading reveal-heading">事前に準備するもの</h2>
			<ul class="list-plain con-prep__list">
				{prep.map((t) => <li>{t}</li>)}
			</ul>
			<p class="con-prep__note">
				すべてを整理してから相談する必要はありません。分かる範囲で公式LINEからお送りください。
			</p>
		</div>
	</section>

	<section class="section section--white con-flow">
		<div class="container">
			<p class="eyebrow reveal-heading">HOW IT WORKS</p>
			<h2 class="con-flow__heading reveal-heading">ご利用の流れ</h2>
			<div class="con-flow__wrap">
				<ServiceFlow steps={flowSteps} />
			</div>
		</div>
	</section>

	<section class="section con-notes">
		<div class="container">
			<p class="eyebrow reveal-heading">NOTES</p>
			<h2 class="con-notes__heading reveal-heading">注意事項</h2>
			<ul class="list-plain con-notes__list">
				{notes.map((t) => <li>{t}</li>)}
			</ul>
		</div>
	</section>

	<section class="section section--white con-faq">
		<div class="container con-faq__grid">
			<div class="con-faq__head">
				<p class="eyebrow reveal-heading">FAQ</p>
				<h2 class="reveal-heading">実務・キャリア相談に<br />よくいただく質問。</h2>
				<ArrowLink href="/faq/">よくある質問をすべて見る</ArrowLink>
			</div>
			<div class="con-faq__list">
				<FaqAccordion items={faqItems} />
			</div>
		</div>
	</section>

	<CTASection primaryLabel="公式LINEで実務・キャリア相談を申し込む" primaryHref="/contact/#consulting">
		話すことで、<br />次に判断することを明確にする。
	</CTASection>
</BaseLayout>

<style>
	.con-topics__list {
		margin-top: 40px;
	}

	.con-flow-talk__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.con-price__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.con-price__wrap {
		margin-top: 32px;
		max-width: 24em;
	}

	.con-price__note {
		margin-top: 24px;
		font-size: 0.9rem;
		opacity: 0.7;
		max-width: 34em;
	}

	.con-prep__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.con-prep__list {
		margin-top: 32px;
	}

	.con-prep__note {
		margin-top: 24px;
		padding-top: 20px;
		border-top: 1px solid var(--color-border);
		font-size: 0.9rem;
		opacity: 0.7;
		max-width: 34em;
	}

	.con-flow__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.con-flow__wrap {
		margin-top: 40px;
	}

	.con-notes__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.con-notes__list {
		margin-top: 32px;
	}

	.con-faq__grid {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.con-faq__head h2 {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.con-faq__head :global(.arrow-link) {
		margin-top: 24px;
	}

	@media (min-width: 1024px) {
		.con-faq__grid {
			flex-direction: row;
			gap: 80px;
		}

		.con-faq__head {
			flex: 0 0 320px;
		}

		.con-faq__list {
			flex: 1;
			max-width: 720px;
		}
	}
</style>
