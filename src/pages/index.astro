---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import FaqItem from "../components/FaqItem.astro";

const questions = [
	{ num: "01", lines: ["このデザインを、", "どの順番でHTMLにする？"] },
	{ num: "02", lines: ["見た目を合わせることと、", "意味のある構造をどう両立する？"] },
	{ num: "03", lines: ["修正が増えたとき、", "どこまで対応する？"] },
	{ num: "04", lines: ["自分の仕事の価値を、", "どう言葉にする？"] },
	{ num: "05", lines: ["AIがコードを書く時代に、", "何を身につける？"] },
];

const perspectives = [
	{
		num: "01",
		tag: "STRUCTURE",
		title: "HTMLとデザインを読む",
		body: "HTMLとは何か、なぜ書くのか。デザインを見た目として再現するだけではなく、文章の構造や情報の優先順位として読み取ります。",
		topics: [
			"HTMLの意味",
			"文章構造",
			"見出し階層",
			"デザインの読み取り方",
			"デザインを「料理する」考え方",
		],
	},
	{
		num: "02",
		tag: "PRACTICE",
		title: "実案件を進める",
		body: "コーディング以外にも、案件では多くの判断が必要です。工数、納期、確認、修正、クライアントとのやり取りを実務として考えます。",
		topics: ["工数の考え方", "納期の伝え方", "修正範囲", "確認方法", "クライアントとの関係づくり"],
	},
	{
		num: "03",
		tag: "VALUE",
		title: "仕事とキャリアをつくる",
		body: "自分の価値をどのように伝え、仕事につなげるのか。AI時代も含め、これからの働き方を考えます。",
		topics: ["自分の強みの伝え方", "仕事を獲得するためのアプローチ", "キャリアアップ", "働き方", "AI時代に身につける力"],
	},
];

const activities = [
	{
		tag: "LEARN",
		title: "月1回のオンライン勉強会",
		body: "HTMLの意味や文章構造、実案件の進め方、クライアントへの伝え方など、コーダーとして判断するためのテーマを取り上げます。代表的な勉強会が「デザイン料理教室」です。デザインデータをそのまま再現するのではなく、情報のまとまりや見出しの階層、読み進める順番を考え、実装できるHTML構造へ組み立てていきます。",
		icon: "book",
	},
	{
		tag: "THINK",
		title: "問題を持ち寄るコミュニティ",
		body: "メンバーが実務の中で困ったことや迷ったことを共有し、それぞれの考え方を持ち寄ります。",
		icon: "people",
	},
	{
		tag: "TALK",
		title: "月1回・60分の個別相談",
		body: "実案件や仕事、キャリアについて、ほかのメンバーがいない環境で相談できます。",
		icon: "chat",
	},
	{
		tag: "APPLY",
		title: "学びを、実案件に持ち帰る",
		body: "勉強会や相談で得た考え方を、目の前の案件でどう使うかまで整理します。知識を聞いて終わらせず、自分で判断し、仕事の中で活かせる状態を目指します。",
		icon: "apply",
	},
];

const icons: Record<string, string> = {
	book: '<path d="M4 5.5C4 4.67 4.67 4 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13Z"/><path d="M20 5.5C20 4.67 19.33 4 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5v-13Z"/>',
	people: '<circle cx="8.5" cy="8" r="3"/><circle cx="16" cy="9.5" r="2.3"/><path d="M3.5 20c.4-3.5 2.6-5.5 5-5.5s4.6 2 5 5.5"/><path d="M14.5 15.3c2 .2 3.6 1.7 4 4.7"/>',
	chat: '<rect x="4" y="5" width="16" height="10" rx="2"/><path d="M9 15v4l-2.5-4"/>',
	link: '<path d="m9 15 6-6"/><path d="M8 6.5 6 8.5a4 4 0 0 0 0 5.7l.7.7"/><path d="M16 17.5 18 15.5a4 4 0 0 0 0-5.7l-.7-.7"/>',
	clipboard: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 3.5h6a1 1 0 0 1 1 1V6H8V4.5a1 1 0 0 1 1-1Z"/><path d="m9 13 2 2 4-4"/>',
	apply: '<path d="M12 3.5v10.5"/><path d="m7.5 10 4.5 4.5L16.5 10"/><path d="M4.5 18.5h15"/>',
};

const faqs = [
	{
		q: "コーディング経験が浅くても参加できますか？",
		a: "経験年数だけで参加を判断するサービスではありません。HTMLやCSSの基本的な学習を進めながら、制作の考え方や実務について学びたい方にもご参加いただけます。",
	},
	{
		q: "勉強会に参加できなかった場合はどうなりますか？",
		a: "アーカイブの提供方法については現在調整中です。正式な運用内容が決まり次第、コーダー部の案内ページでお知らせします。",
	},
	{
		q: "個別相談では、どのようなことを相談できますか？",
		a: "実案件の進め方、工数、納期、修正対応、クライアントとのやり取り、仕事の獲得、今後の働き方などをご相談いただけます。",
	},
	{
		q: "案件の内容やクライアント情報は外部に公開されませんか？",
		a: "ご相談いただいた案件やクライアントに関する情報を、許可なく外部へ公開することはありません。必要に応じて、個人名や会社名を伏せた状態でご相談ください。",
	},
	{
		q: "コーダー部の退会方法を教えてください。",
		a: "退会方法と手続き期限については、決済方法の確定後にコーダー部の案内ページへ掲載します。",
	},
];
---

<BaseLayout
	title="MARORIRI｜制作者として考え、判断する力を育てる"
	description="MARORIRIは、コーダー・Web制作者が、HTMLやデザインの構造、実案件の進め方、クライアントとの関係、キャリアについて考え、自分なりの判断基準を育てるための場所です。"
>
	<!-- 1. ファーストビュー -->
	<section class="hero section" id="hero">
		<div class="container hero__grid">
			<div class="hero__copy">
				<p class="eyebrow reveal-heading">CODE IS NOT THE GOAL.</p>
				<h1 class="hero__heading reveal-heading">コードを書く。<br />その前に、考える。</h1>
				<div class="hero__body">
					<p>
						HTMLを構造として読み、デザインの意図を受け取り、<br />
						仕事の中で自分なりの基準を持って判断する。
					</p>
					<p>
						MARORIRIは、コーダー・Web制作者が<br />
						「考え、選び、説明する力」を育てるための場所です。
					</p>
				</div>
				<div class="hero__cta">
					<a href="/coder-club/" class="btn btn--primary">マロリリコーダー部を見る</a>
					<ArrowLink href="/about/">MARORIRIについて</ArrowLink>
				</div>
			</div>

			<div class="hero__graphic reveal" aria-hidden="true">
				<div class="html-graphic">
					<p class="html-graphic__tag" style="--i:0">&lt;main&gt;</p>
					<div class="html-graphic__indent">
						<p class="html-graphic__tag" style="--i:1">&lt;section&gt;</p>
						<div class="html-graphic__indent">
							<p class="html-graphic__tag" style="--i:2">&lt;h1&gt;</p>
							<div class="html-graphic__indent">
								<div class="html-graphic__block" style="--i:3"></div>
							</div>
							<p class="html-graphic__tag" style="--i:4">&lt;/h1&gt;</p>
							<p class="html-graphic__tag" style="--i:5">&lt;p&gt;</p>
							<div class="html-graphic__indent">
								<div class="html-graphic__block html-graphic__block--wide" style="--i:6"></div>
								<div class="html-graphic__block" style="--i:7"></div>
							</div>
							<p class="html-graphic__tag" style="--i:8">&lt;/p&gt;</p>
							<p class="html-graphic__note" style="--i:9">WHY?</p>
						</div>
						<p class="html-graphic__tag" style="--i:10">&lt;/section&gt;</p>
					</div>
					<p class="html-graphic__tag" style="--i:11">&lt;/main&gt;</p>
					<p class="html-graphic__stamp" style="--i:12">THINK BEFORE CODE.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. MARORIRIの立ち位置 -->
	<section class="positioning section" id="positioning">
		<div class="container positioning__grid">
			<p class="eyebrow reveal-heading">NOT A CODE SCHOOL</p>
			<div class="positioning__content">
				<h2 class="reveal-heading">
					検索すれば、答えは出てくる。<br />けれど、仕事では答えを選ぶ力がいる。
				</h2>
				<div class="positioning__body">
					<p>エラーの直し方やコードの書き方は、ネットやAIで調べられます。</p>
					<p>MARORIRIが扱うのは、その先にある判断です。</p>
					<ul class="positioning__list">
						<li>なぜ、このHTMLを書くのか。</li>
						<li>デザインを、どう文章構造に置き換えるのか。</li>
						<li>工数や納期、修正範囲を、どう考えて伝えるのか。</li>
						<li>自分の仕事の価値を、どう次の仕事につなげるのか。</li>
					</ul>
					<p>コードを覚えることではなく、<br />制作者として考えるための基準を育てます。</p>
				</div>
				<ArrowLink href="/about/">MARORIRIについて詳しく見る</ArrowLink>
			</div>
		</div>
	</section>

	<!-- 3. 制作者が仕事の中で向き合う問い -->
	<section class="questions section section--white" id="questions">
		<span class="questions__quote" aria-hidden="true">”</span>
		<div class="container">
			<div class="questions__head">
				<p class="eyebrow reveal-heading">QUESTIONS FROM THE FIELD</p>
				<h2 class="reveal-heading">コードだけでは解決できないことがある。</h2>
			</div>
			<ul class="questions__list">
				{
					questions.map((q) => (
						<li class="questions__item">
							<div class="reveal">
								<span class="questions__num num-mono" aria-hidden="true">{q.num}</span>
								<h3 class="questions__text">
									{q.lines.map((line) => <span class="questions__line">{line}</span>)}
								</h3>
								<span class="questions__rule reveal-rule" aria-hidden="true" />
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- 4. MARORIRIで扱う3つの領域 -->
	<section class="perspectives section" id="perspectives">
		<div class="container">
			<div class="perspectives__head">
				<p class="eyebrow reveal-heading">THREE PERSPECTIVES</p>
				<h2 class="reveal-heading">技術だけではなく、<br />仕事全体を考える。</h2>
			</div>
			<ul class="perspectives__list">
				{
					perspectives.map((p, i) => (
						<li class:list={["perspectives__item", `perspectives__item--${i}`]}>
							<div class="perspectives__meta">
								<span class="num-mono perspectives__num">{p.num}</span>
								<span class="eyebrow">{p.tag}</span>
							</div>
							<div class="perspectives__content">
								<h3>{p.title}</h3>
								<p class="perspectives__body">{p.body}</p>
								<ul class="perspectives__topics">
									{p.topics.map((t) => <li>{t}</li>)}
								</ul>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- 5. マロリリコーダー部 -->
	<section class="coder-club section section--dark" id="coder-club">
		<div class="container">
			<div class="coder-club__head">
				<p class="eyebrow reveal-heading">MARORIRI CODER CLUB</p>
				<h2 class="reveal-heading">
					ひとりで正解を探すのではなく、<br />考え方を持ち寄り、自分の基準を育てる。
				</h2>
			</div>

			<div class="coder-club__row">
				<div class="coder-club__body">
					<p>
						マロリリコーダー部は、コーダー・Web制作者が、実務で感じた疑問や迷いを持ち寄る月額制のコミュニティです。
					</p>
					<p>
						デザインをHTML構造へ落とし込む「デザイン料理教室」をはじめ、工数、納期、修正、クライアントとの関係、仕事の獲得方法など、コードだけでは解決できないテーマを扱います。
					</p>
					<p>
						正解を教えてもらうだけではなく、ほかの制作者の考え方にも触れながら、自分なりの判断基準を育てていきます。
					</p>
				</div>

				<div class="coder-club__fee">
					<span class="eyebrow">MONTHLY FEE</span>
					<p class="coder-club__price">月額 3,300<span class="coder-club__price-unit">円</span></p>
					<p class="coder-club__price-note">税込</p>
				</div>
			</div>

			<ul class="coder-club__activities">
				{
					activities.map((a) => (
						<li class="coder-club__activity">
							<span class="icon-badge">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									set:html={icons[a.icon]}
								/>
							</span>
							<span class="eyebrow">{a.tag}</span>
							<h3>{a.title}</h3>
							<p>{a.body}</p>
						</li>
					))
				}
			</ul>

			<div class="coder-club__past">
				<span class="eyebrow">PAST ACTIVITY</span>
				<p class="coder-club__past-title">コーダーによるデザイン料理教室</p>
				<div class="coder-club__past-body">
					<p>
						ひとつのデザインを題材に、見出し階層やリスト、文章のまとまりをどう読み取り、HTMLへ落とし込むかをZoomで解説しました。
					</p>
					<p>
						「この見た目を、どの構造で実装するか」という正解が一つではない問いを、特別ゲストと参加者の皆さんと一緒に考えたオンライン企画です。
					</p>
				</div>
				<p class="coder-club__past-meta">2025年8月開催 ／ 約60名が参加</p>
			</div>

			<ArrowLink href="/coder-club/">マロリリコーダー部の内容を見る</ArrowLink>
		</div>
	</section>

	<!-- 6. 実案件を支えるサービス -->
	<section class="services section" id="services">
		<div class="container">
			<div class="services__head">
				<p class="eyebrow reveal-heading">REAL WORK SUPPORT</p>
				<h2 class="reveal-heading">目の前の案件について、<br />具体的に相談したいときに。</h2>
			</div>

			<div class="services__grid">
				<article class="services__card services__card--main">
					<div class="services__main">
						<span class="icon-badge">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={icons.clipboard}
							/>
						</span>
						<span class="eyebrow">CASE CHECK</span>
						<div class="services__title-row">
							<h3>案件チェック</h3>
							<dl class="services__price">
								<div>
									<dt>一般価格</dt>
									<dd>10,000円（税込）</dd>
								</div>
								<div>
									<dt>コーダー部会員価格</dt>
									<dd>5,000円（税込）</dd>
								</div>
							</dl>
						</div>
						<p class="services__body">
							制作した案件を、HTMLの構造、デザインの再現、表示、操作性などの視点から確認します。
						</p>
						<p class="services__body">
							単に間違いを指摘するのではなく、なぜ直したほうがよいのか、次の案件でどう考えればよいのかまでお伝えします。
						</p>
						<ArrowLink href="/case-check/">案件チェックについて見る</ArrowLink>
					</div>
				</article>

				<article class="services__card services__card--sub">
					<div class="services__main">
						<span class="icon-badge">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={icons.chat}
							/>
						</span>
						<span class="eyebrow">1ON1 CONSULTING</span>
						<div class="services__title-row">
							<h3>単発個別相談</h3>
							<dl class="services__price">
								<div>
									<dt>60分</dt>
									<dd>5,000円（税込）</dd>
								</div>
							</dl>
						</div>
						<p class="services__body">
							案件の進め方、工数、納期、修正、クライアントとの関係、仕事の獲得、キャリアなどについて相談できます。
						</p>
						<p class="services__note">コーダー部会員は、月1回60分の個別相談を月会費に含みます。</p>
						<ArrowLink href="/consulting/">個別相談について見る</ArrowLink>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- 7. 運営者紹介 -->
	<section class="profile section section--white" id="profile">
		<div class="container">
			<div class="profile__head">
				<p class="eyebrow reveal-heading">FROM THE WEB FIELD</p>
				<h2 class="reveal-heading">制作現場で積み重ねてきた判断を、<br />次の制作者へ。</h2>
			</div>

			<div class="profile__row">
				<div class="profile__body">
					<p class="profile__lede">印刷・DTPからWeb制作へ。</p>
					<p>
						コーディング、サイト運用、ディレクション、<br />
						制作者の育成まで、立場を変えながら<br />
						制作の仕事に携わってきました。
					</p>
					<p>
						制作現場で必要になるのは、<br />
						コードを書く技術だけではありません。
					</p>
					<p>
						デザインの意図を読み取り、<br />
						相手に伝わる形へ整理し、<br />
						案件を前へ進めるための判断が求められます。
					</p>
					<p>
						MARORIRIでは、現場で身につけてきた<br />
						考え方や判断の基準を、これからの制作者へ伝えています。
					</p>
					<ArrowLink href="/profile/">運営者について見る</ArrowLink>
				</div>

				<div class="profile__info">
					<p class="profile__name-en num-mono">MAYUMI KATAYAMA</p>
					<p class="profile__name-ja">片山 まゆみ</p>
					<ul class="profile__roles">
						<li>WEB CREATOR</li>
						<li>DIRECTOR</li>
						<li>CREATOR SUPPORT</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- 8. よくある質問 -->
	<section class="faq section" id="faq">
		<div class="container faq__grid">
			<div class="faq__head">
				<p class="eyebrow reveal-heading">FAQ</p>
				<h2 class="reveal-heading">参加や相談について、<br />よくいただく質問。</h2>
			</div>
			<div class="faq__list">
				{faqs.map((item) => <FaqItem question={item.q}>{item.a}</FaqItem>)}
				<div class="faq__more">
					<ArrowLink href="/faq/">よくある質問をすべて見る</ArrowLink>
				</div>
			</div>
		</div>
	</section>

	<!-- 9. 最終CTA -->
	<section class="final-cta section section--dark" id="final-cta">
		<div class="container">
			<p class="final-cta__en reveal-heading">
				YOU DON'T NEED MORE ANSWERS.<br />YOU NEED YOUR OWN CRITERIA.
			</p>
			<h2 class="reveal-heading">答えを集めるだけでなく、<br />自分で考え、選び、説明できる制作者へ。</h2>
			<div class="final-cta__body">
				<p>仕事の中で迷っていること、これから身につけたいことを、一人で抱え続ける必要はありません。</p>
				<p>マロリリコーダー部への参加や各サービスについて、気になることがあればお問い合わせください。</p>
			</div>
			<div class="final-cta__actions">
				<a href="/coder-club/" class="btn btn--primary">コーダー部に参加する</a>
