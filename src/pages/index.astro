---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/ArrowLink.astro";
import FaqItem from "../components/FaqItem.astro";
import { withBase } from "../utils/url";

const perspectives = [
	{
		num: "01",
		tag: "STRUCTURE",
		title: "HTMLとデザインを読む",
		body: "見た目の奥にある文章構造や情報の優先順位を読み取り、HTMLに落とし込みます。",
		img: { name: "perspective-structure", w: 1456, h: 1080 },
	},
	{
		num: "02",
		tag: "PRACTICE",
		title: "実案件を進める",
		body: "工数・納期・修正範囲を整理し、クライアントに伝えながら案件を進める考え方を学びます。",
		img: { name: "perspective-practice", w: 1455, h: 1081 },
	},
	{
		num: "03",
		tag: "VALUE",
		title: "仕事とキャリアをつくる",
		body: "今ある経験や強みを整理し、仕事の広げ方とこれからの働き方を考えます。",
		img: { name: "perspective-value", w: 1455, h: 1081 },
	},
];

// 下層ページ（/maroriri-plus/）の「できること」一覧と、テキスト（text）を一致させる。片方だけ更新しないこと。
const coderClubFeatures = [
	{ icon: "monitor", text: "月1回のオンライン勉強会" },
	{ icon: "archive", text: "勉強会のアーカイブ" },
	{ icon: "people", text: "メンバー同士で交流・相談できるコミュニティ" },
	{ icon: "chat", text: "コミュニティ内での軽い実務相談" },
	{ icon: "idea", text: "実際の案件や疑問を題材にした考え方の共有" },
];

const positioningPoints = [
	{ q: "何を選ぶ？", a: "デザインに合うHTML構造" },
	{ q: "なぜそうする？", a: "実装方法を選ぶ理由" },
	{ q: "どう伝える？", a: "工数・納期・修正範囲" },
];

// 今後、開催予定・募集案内が確定したら項目を追加する。2講座は主従をつけず同列で扱うこと。
const courses = [
	{
		tag: "コーディングマインド講座",
		title: "コードを書く前に、考えること。",
		body: [
			"HTMLの意味や文章構造、デザインの意図、クライアントからの指示の受け取り方など、コーダーとして仕事をするときに必要になる「考え方」を扱う講座です。",
			"正解のコードを覚えるのではなく、状況に合わせて自分で判断できる力を身につけることを目指します。",
		],
	},
	{
		tag: "コーダーによるデザイン料理教室",
		title: "デザインを、実装できる形まで読み解く。",
		body: [
			"完成したデザインを見て、どこからHTMLを組み立てるのか。どこを共通化し、どこをCSSで表現するのか。",
			"デザインをそのまま再現するのではなく、コーダーの視点から構造を読み取り、実装へ落とし込む考え方を学ぶ講座です。",
		],
	},
];

const icons: Record<string, string> = {
	chat: '<rect x="4" y="5" width="16" height="10" rx="2"/><path d="M9 15v4l-2.5-4"/>',
	clipboard: '<rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 3.5h6a1 1 0 0 1 1 1V6H8V4.5a1 1 0 0 1 1-1Z"/><path d="m9 13 2 2 4-4"/>',
	monitor: '<rect x="3" y="5" width="18" height="12" rx="1.5"/><path d="M8.5 20h7M12 17v3"/>',
	archive: '<path d="M4 4h16v4H4z"/><path d="M5 8v10.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V8"/><path d="M10 12.5h4"/>',
	people: '<circle cx="8.5" cy="8" r="3"/><circle cx="16" cy="9.5" r="2.3"/><path d="M3.5 20c.4-3.5 2.6-5.5 5-5.5s4.6 2 5 5.5"/><path d="M14.5 15.3c2 .2 3.6 1.7 4 4.7"/>',
	idea: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3 11.2c.6.4 1 1.1 1 1.8h4c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3Z"/>',
};

const faqs = [
	{
		q: "コーディング経験が浅くても参加できますか？",
		a: "HTML・CSSの基礎学習を終え、実案件または実案件に近い制作に取り組んでいる方を主な対象としています。経験年数より、制作や実務について自分で考えたいという姿勢を大切にしています。",
	},
	{
		q: "勉強会に参加できなかった場合はどうなりますか？",
		a: "勉強会に参加できなかった場合も、アーカイブをご覧いただけます。勉強会のアーカイブは、maroriri Plusの月額料金に含まれています。",
	},
	{
		q: "個別相談では、どのようなことを相談できますか？",
		a: "実案件の進め方、工数、納期、修正対応、クライアントとのやり取り、仕事の獲得、今後の働き方などをご相談いただけます。",
	},
	{
		q: "案件の内容やクライアント情報は外部に公開されませんか？",
		a: "個別相談でお聞きした案件情報を、許可なく外部へ公開することはありません。コミュニティへの投稿は参加メンバーが閲覧できるため、クライアント名や非公開情報などを伏せてご相談ください。",
	},
	{
		// 未確定：決済方法が確定するまでは、この保留表現のまま維持する（確認用ページでの報告事項）。
		q: "maroriri Plusの退会方法を教えてください。",
		a: "退会方法と手続き期限については、決済方法の確定後にmaroriri Plusの案内ページへ掲載します。",
	},
];
---

<BaseLayout
	title="MARORIRI｜制作者として考え、判断する力を育てる"
	description="MARORIRIは、コーダー・Web制作者が、HTMLやデザインの構造、実案件の進め方、クライアントとの関係、キャリアについて考え、自分なりの判断基準を育てるための場所です。"
>
	<!-- 1. ファーストビュー -->
	<section class="hero section" id="hero">
		<div class="container hero__grid">
			<div class="hero__copy">
				<p class="eyebrow reveal-heading">CODE IS NOT THE GOAL.</p>
				<h1 class="hero__heading reveal-heading">コードを書く。<br />その前に、考える。</h1>
				<div class="hero__body">
					<p class="hero__direction">コーディングを土台に、仕事の領域を広げる。</p>
					<p>
						MARORIRIは、コーダー・Web制作者が、制作や実務の迷いを相談しながら「考え、選び、説明する力」を育てる場所です。
					</p>
				</div>
				<div class="hero__cta">
					<a href={withBase("/maroriri-plus/")} class="btn btn--primary">maroriri Plusを見る</a>
					<ArrowLink href="/about/">MARORIRIについて</ArrowLink>
				</div>
			</div>

			<div class="hero__graphic">
				<img
					src={withBase("/assets/img/top/hero-illustration.webp")}
					alt=""
					width="1310"
					height="1201"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</section>

	<!-- 2. MARORIRIの立ち位置 -->
	<section class="positioning section" id="positioning">
		<div class="container positioning__grid">
			<div class="positioning__copy">
				<p class="eyebrow reveal-heading">NOT A CODE SCHOOL</p>
				<h2 class="reveal-heading">
					検索すれば、答えは出てくる。<br />けれど、仕事では<br />答えを選ぶ力がいる。
				</h2>
				<div class="positioning__body">
					<p>コードの書き方が分かっても、実際の仕事では迷う場面があります。MARORIRIでは、選んだ理由まで説明できるよう、具体的な案件をもとに考えます。</p>
				</div>
				<ArrowLink href="/about/">MARORIRIについて詳しく見る</ArrowLink>
			</div>

			<div class="positioning__visual">
				<img
					src={withBase("/assets/img/top/positioning-illustration.webp")}
					alt=""
					width="1402"
					height="1122"
					loading="lazy"
				/>
				<ul class="positioning__points">
					{
						positioningPoints.map((p) => (
							<li>
								<span class="positioning__q">{p.q}</span>
								<span class="positioning__a">{p.a}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- 3. MARORIRIで扱う3つの領域 -->
	<section class="perspectives section" id="perspectives">
		<div class="container">
			<div class="perspectives__head">
				<p class="eyebrow reveal-heading">THREE PERSPECTIVES</p>
				<h2 class="reveal-heading">技術だけではなく、<br />仕事全体を考える。</h2>
			</div>
			<ul class="perspectives__list">
				{
					perspectives.map((p) => (
						<li class="perspectives__item">
							<div class="perspectives__visual">
								<img
									src={withBase(`/assets/img/top/${p.img.name}.webp`)}
									alt=""
									width={p.img.w}
									height={p.img.h}
									loading="lazy"
								/>
							</div>
							<span class="num-mono perspectives__num">{p.num}</span>
							<h3>{p.title}</h3>
							<p class="perspectives__body">{p.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- 4. サービス紹介：maroriri Plus（中心サービス） -->
	<section class="coder-club section section--dark" id="coder-club">
		<div class="container">
			<div class="coder-club__intro">
				<div class="coder-club__copy">
					<p class="eyebrow reveal-heading">maroriri Plus</p>
					<h2 class="reveal-heading">一人で歩く。<br />でも、独りではない。</h2>
					<p class="coder-club__lede">
						実務の疑問や迷いを持ち寄る、コーダー・Web制作者のための月額コミュニティです。月1回の勉強会や交流を通じて、ほかの制作者の視点に触れ、自分なりの判断基準を育てます。
					</p>
					<ArrowLink href="/maroriri-plus/">maroriri Plusの内容を詳しく見る</ArrowLink>
				</div>

				<div class="coder-club__visual">
					<img
						src={withBase("/assets/img/top/coder-club-illustration.webp")}
						alt=""
						width="1254"
						height="1254"
						loading="lazy"
					/>
					<div class="coder-club__fee">
						<span class="eyebrow">MONTHLY FEE</span>
						<p class="coder-club__price">月額 3,300<span class="coder-club__price-unit">円</span></p>
						<p class="coder-club__price-note">税込</p>
					</div>
				</div>
			</div>

			<ul class="coder-club__features">
				{
					coderClubFeatures.map((f) => (
						<li>
							<span class="icon-badge">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									set:html={icons[f.icon]}
								/>
							</span>
							<p>{f.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- 4. サービス紹介：案件チェック／実務・キャリア相談（補助サービス） -->
	<section class="services section" id="services">
		<div class="container">
			<div class="services__head">
				<p class="eyebrow reveal-heading">REAL WORK SUPPORT</p>
				<h2 class="reveal-heading">目の前の案件について、<br />具体的に相談したいときに。</h2>
			</div>

			<div class="services__grid">
				<article class="services__card services__card--main">
					<div class="services__visual">
						<img
							src={withBase("/assets/img/top/case-check-illustration.webp")}
							alt=""
							width="1484"
							height="1060"
							loading="lazy"
						/>
					</div>
					<div class="services__main">
						<span class="icon-badge">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={icons.clipboard}
							/>
						</span>
						<span class="eyebrow">CASE CHECK</span>
						<div class="services__title-row">
							<h3>案件チェック</h3>
							<dl class="services__price">
								<div>
									<dt>一般価格</dt>
									<dd>10,000円（税込）</dd>
								</div>
								<div>
									<dt>maroriri Plus会員価格</dt>
									<dd>5,000円（税込）</dd>
								</div>
							</dl>
						</div>
						<p class="services__body">
							制作したサイトを、HTML構造・デザインの再現・表示・操作性から確認。修正箇所だけでなく、その理由と次の案件での考え方までお伝えします。
						</p>
						<ArrowLink href="/case-check/">案件チェックについて見る</ArrowLink>
					</div>
				</article>

				<article class="services__card services__card--sub">
					<div class="services__visual">
						<img
							src={withBase("/assets/img/top/consulting-illustration.webp")}
							alt=""
							width="1484"
							height="1060"
							loading="lazy"
						/>
					</div>
					<div class="services__main">
						<span class="icon-badge">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={icons.chat}
							/>
						</span>
						<span class="eyebrow">1ON1 CONSULTING</span>
						<div class="services__title-row">
							<h3>単発個別相談</h3>
							<dl class="services__price">
								<div>
									<dt>60分</dt>
									<dd>5,000円（税込）</dd>
								</div>
							</dl>
						</div>
						<p class="services__body">
							案件の進め方、見積もり、クライアント対応、今後の働き方などを、60分の個別相談で一緒に整理します。
						</p>
						<p class="services__note">個別相談は、maroriri Plusの月額料金とは別料金です。</p>
						<ArrowLink href="/consulting/">個別相談について見る</ArrowLink>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- 5. 講座・活動実績 -->
	<section class="courses section section--white" id="courses">
		<div class="container">
			<div class="courses__head">
				<p class="eyebrow reveal-heading">LEARN WITH MARORIRI</p>
				<h2 class="reveal-heading">講座・活動実績</h2>
				<p class="courses__lede">実務で身につけた「考え方」を、次のコーダーへ。</p>
				<p class="courses__intro">
					コーディングの技術だけではなく、「なぜこのHTMLにするのか」「デザインをどう読み取るのか」など、実際の制作現場で必要になる考え方を伝える講座を開催しています。
				</p>
			</div>
			<div class="courses__cards">
				{
					courses.map((c) => (
						<article class="courses__card">
							<span class="courses__card-tag">{c.tag}</span>
							<h3 class="courses__card-title">{c.title}</h3>
							<div class="courses__card-body">
								{c.body.map((line) => <p>{line}</p>)}
							</div>
							{c.date && (
								<div class="courses__meta">
									<p class="courses__meta-date">{c.date}</p>
									<p class="courses__meta-count">
										<span class="courses__meta-num">{c.count}</span>
										{c.countNote}
									</p>
								</div>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- 6. 運営者紹介 -->
	<section class="profile section section--white" id="profile">
		<div class="container">
			<div class="profile__head">
				<p class="eyebrow reveal-heading">FROM THE WEB FIELD</p>
				<h2 class="reveal-heading">制作現場で積み重ねてきた判断を、<br />次の制作者へ。</h2>
			</div>

			<div class="profile__row">
				<div class="profile__body">
					<p>
						印刷・DTPからWeb制作へ。コーディング、サイト運用、ディレクション、制作者の育成まで、制作の現場に携わってきました。現在も実務に取り組みながら、制作の考え方や案件の進め方を伝えています。
					</p>
					<ArrowLink href="/profile/">運営者について見る</ArrowLink>
				</div>

				<div class="profile__info">
					<img
						src={withBase("/assets/img/top/profile-illustration.webp")}
						alt=""
						width="1355"
						height="1161"
						loading="lazy"
						class="profile__visual"
					/>
					<p class="profile__name-en num-mono">MAYUMI KATAYAMA</p>
					<p class="profile__name-ja">片山 まゆみ</p>
					<ul class="profile__roles">
						<li>WEB CREATOR</li>
						<li>DIRECTOR</li>
						<li>CREATOR SUPPORT</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- 7. よくある質問 -->
	<section class="faq section" id="faq">
		<div class="container faq__grid">
			<div class="faq__head">
				<p class="eyebrow reveal-heading">FAQ</p>
				<h2 class="reveal-heading">参加や相談について、<br />よくいただく質問。</h2>
			</div>
			<div class="faq__list">
				{faqs.map((item) => <FaqItem question={item.q}>{item.a}</FaqItem>)}
				<div class="faq__more">
					<ArrowLink href="/faq/">よくある質問をすべて見る</ArrowLink>
				</div>
			</div>
		</div>
	</section>

	<!-- 8. 最終CTA -->
	<section class="final-cta section section--dark" id="final-cta">
		<div class="container">
			<h2 class="reveal-heading">答えを集めるだけでなく、<br />自分で考え、選び、説明できる制作者へ。</h2>
			<div class="final-cta__body">
				<p>継続して学びたい方はmaroriri Plusへ。まずは個別に相談したい方も、お気軽にお問い合わせください。</p>
			</div>
			<div class="final-cta__actions">
				<a href={withBase("/maroriri-plus/")} class="btn btn--primary">maroriri Plusを見る</a>
				<ArrowLink href="/contact/">まずは相談する</ArrowLink>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* 画像が白背景の素材のため、ダーク以外のセクションを白（#fff）に統一して境界をなじませる */
	.hero.section,
	.positioning.section,
	.perspectives.section,
	.services.section,
	.faq.section {
		background: var(--color-bg-white);
	}

	/* ---------- Hero ---------- */
	.hero__grid {
		display: flex;
		flex-direction: column;
		gap: 56px;
	}

	.hero__heading {
		margin-top: 20px;
		font-family: var(--font-en);
		font-weight: 700;
		font-size: clamp(1.9rem, 1.3rem + 3vw, 3.3rem);
		line-height: 1.3;
	}

	.hero__body {
		margin-top: 28px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		font-size: 1.0625rem;
		max-width: 34em;
	}

	.hero__direction {
		font-weight: 500;
	}

	.hero__cta {
		margin-top: 40px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 28px;
	}

	.hero__graphic {
		width: 100%;
	}

	.hero__graphic img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* ---------- Positioning ---------- */
	.positioning__grid {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.positioning__copy h2 {
		margin-top: 16px;
		font-size: clamp(1.5rem, 1.2rem + 2vw, 2.4rem);
		line-height: 1.5;
	}

	.positioning__body {
		margin-top: 32px;
		max-width: 36em;
		font-size: 1.0625rem;
	}

	.positioning__copy :global(.arrow-link) {
		margin-top: 32px;
	}

	.positioning__visual img {
		display: block;
		width: 100%;
		height: auto;
	}

	.positioning__points {
		margin-top: 24px;
		display: flex;
		flex-direction: column;
	}

	.positioning__points li {
