---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PriceBlock from "../../components/PriceBlock.astro";
import ServiceFlow from "../../components/ServiceFlow.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import CTASection from "../../components/CTASection.astro";
import { coderClub, caseCheck, consulting } from "../../data/services";
import { faqCategories } from "../../data/faq";

const concerns = [
	"コーディングはできるようになった。でも、この先どう仕事を広げればよいかわからない",
	"指示どおりには作れるが、自分で判断する場面になると迷う",
	"デザインの意図を、どうHTMLやCSSに落とし込むか悩むことがある",
	"工数・納期・修正・クライアント対応など、制作以外の判断に迷う",
	"AIでコードが書ける時代に、自分は何を強みにすればよいのかわからない",
	"実務の疑問を、気軽に相談できる相手がいない",
];

const included = [
	{
		num: "01",
		title: "月1回のオンライン勉強会",
		body: "HTMLやデザイン、案件の進め方、クライアント対応など、実務で必要になる「考え方」をテーマに取り上げます。",
	},
	{
		num: "02",
		title: "勉強会のアーカイブ",
		body: "リアルタイムで参加できなかった場合も、あとから勉強会の内容を確認できます。",
	},
	{
		num: "03",
		title: "メンバー同士で交流・相談できるコミュニティ",
		body: "一人で制作していると見えにくい、ほかの制作者の考え方や仕事の進め方に触れることができます。",
	},
	{
		num: "04",
		title: "コミュニティ内での軽い実務相談",
		body: "日々の仕事で「これ、どう考えたらいい？」と迷ったときに、コミュニティへ投稿して相談できます。答えだけではなく、確認するポイントや判断するための考え方をお伝えします。",
	},
	{
		num: "05",
		title: "実際の案件や疑問を題材にした考え方の共有",
		body: "実務の中で起きたことを題材に、「なぜそうするのか」「ほかにどんな考え方があるのか」を共有します。",
	},
];

const themes = [
	{
		title: "HTML・文章構造",
		body: "デザインをそのまま再現するのではなく、文章の意味や情報の関係を読み取り、どのようなHTML構造にするかを考えます。",
	},
	{
		title: "デザインの読み取り",
		body: "余白、強弱、まとまり、視線の流れなどから、デザイナーが何を意図しているのかを読み取り、実装へ落とし込む方法を考えます。",
	},
	{
		title: "案件の進め方",
		body: "工数、納期、修正範囲、確認方法など、制作を仕事として進めるために必要な判断を扱います。",
	},
	{
		title: "クライアント対応",
		body: "「できる・できない」だけではなく、なぜそう判断したのかを相手に伝える力を身につけます。",
	},
	{
		title: "キャリアとこれからの働き方",
		body: "AIでコードが書ける時代に、これまでの経験をどう活かし、どんな仕事へ領域を広げていくのかを一緒に考えます。",
	},
];

const whoItsFor = [
	"コーディングの先に仕事の幅を広げたい",
	"自分の判断にもう少し自信を持ちたい",
	"ほかの制作者がどう考えているのか知りたい",
	"制作だけでなく、案件の進め方やクライアント対応も学びたい",
	"これからの自分の働き方を考えたい",
];

const lightConsult = [
	"日々の実務で生じた疑問を、コミュニティへ投稿して相談するものです。",
	"考え方や確認ポイントについて、簡単なヒントや方向性をお伝えします。",
	"画面共有、制作物全体の確認、詳細なコードレビューなどは含みません。",
];

const bookedConsult = [
	"事前予約制で、60分間1対1で相談するサービスです。",
	"案件、クライアント対応、見積もり、進行、キャリアなどについて、必要に応じて資料や制作物を見ながら一緒に整理します。",
];

const flowSteps = [
	{ num: "01", title: "公式LINEを友だち追加" },
	{ num: "02", title: "「プラス」と送信" },
	{ num: "03", title: "参加方法・利用方法の案内を確認" },
	{ num: "04", title: "申込み手続き" },
	{ num: "05", title: "maroriri Plusへ参加" },
];

const faqItems = faqCategories.find((c) => c.id === "coder-club")!.items;
---

<BaseLayout
	title="maroriri Plus｜MARORIRI"
	description="maroriri Plusは、コーダー・Web制作者が実務の疑問や迷いを持ち寄り、制作者としての判断基準を育てる月額制のコミュニティです。"
>
	<PageHero eyebrow="maroriri Plus" crumbLabel="maroriri Plus">
		一人で歩く。<br />でも、独りではない。
		<Fragment slot="lede">
			<p>
				「一人」は、自分で考え、自分で選び、自分の足で歩くこと。<br />
				「独りではない」は、迷ったときに、一緒に考えられる人がいること。
			</p>
			<p>
				maroriri Plusは、実務の中で生まれる疑問や迷いを持ち寄り、自分なりの判断基準を育てていく、コーダー・Web制作者のための月額コミュニティです。
			</p>
			<p class="hero-sub">コーディングを土台に、仕事の領域を少しずつ広げていきます。</p>
		</Fragment>
	</PageHero>

	<div class="container hero-cta">
		<ArrowLink href="#about">maroriri Plusの内容を見る</ArrowLink>
	</div>

	<section class="section section--white plus-concerns">
		<div class="container">
			<SectionHeading eyebrow="SOUND FAMILIAR?">こんなことに、心当たりはありませんか。</SectionHeading>
			<p class="plus-concerns__lead">制作の仕事を続けていると、コードの書き方だけでは解決できないことが少しずつ増えていきます。</p>
			<ul class="list-plain plus-concerns__list">
				{concerns.map((t) => <li>{t}</li>)}
			</ul>
		</div>
	</section>

	<section class="section plus-about" id="about">
		<div class="container">
			<SectionHeading eyebrow="WHAT IS maroriri Plus">答えをもらう場所ではなく、<br />自分で判断できるようになる場所。</SectionHeading>
			<div class="plus-about__body">
				<p>maroriri Plusでは、「こう書けば正解」「こうすれば大丈夫」という答えだけを渡すことを目的にしていません。</p>
				<p>HTMLの構造、デザインの読み取り方、案件の進め方、クライアントへの伝え方、工数や納期、これからの働き方。</p>
				<p>実務の中で出てくるさまざまなテーマについて、「なぜそう考えるのか」を一緒に整理します。</p>
				<p>ほかの制作者の考え方にも触れながら、次に似た場面に出会ったとき、自分で考え、選び、説明できるようになることを目指します。</p>
			</div>
		</div>
	</section>

	<section class="section plus-get">
		<div class="container">
			<SectionHeading eyebrow="WHAT YOU GET">maroriri Plusでできること</SectionHeading>
			<div class="plus-get__wrap">
				<ServiceFlow steps={included} />
			</div>
			<p class="plus-get__note">
				※事前予約制の60分個別相談「実務・キャリア相談」は月額料金には含まれません。
			</p>
		</div>
	</section>

	<section class="section plus-themes">
		<div class="container">
			<SectionHeading eyebrow="TOPICS WE COVER">コーディングだけでは終わらない、<br />制作の仕事を考える。</SectionHeading>
			<p class="plus-themes__lead">
				maroriri Plusで扱うのは、コードの書き方だけではありません。コーダー・Web制作者として仕事を続けていく中で必要になる、さまざまな「判断」をテーマにします。
			</p>
			<ul class="plus-themes__list">
				{
					themes.map((t) => (
						<li>
							<h3>{t.title}</h3>
							<p>{t.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section section--white plus-change">
		<div class="container">
			<SectionHeading eyebrow="THE CHANGE YOU BUILD">自分で判断し、<br />その理由を説明できるように。</SectionHeading>
			<div class="plus-change__body">
				<p>仕事では、いつも正解が一つとは限りません。</p>
				<p>案件の目的、デザイン、予算、納期、クライアントの状況によって、選ぶ方法が変わることもあります。</p>
				<p>maroriri Plusで身につけたいのは、正解をたくさん覚えることではありません。</p>
				<p>「今回は、なぜこの方法を選ぶのか」自分で考え、選び、その理由を自分の言葉で説明できること。</p>
				<p>それが、仕事を続けていくための自分なりの判断基準になっていきます。</p>
			</div>
		</div>
	</section>

	<section class="section plus-who">
		<div class="container">
			<SectionHeading eyebrow="WHO IT'S FOR">こんな方に参加してほしいと思っています。</SectionHeading>
			<p class="plus-who__lead">
				maroriri Plusは、すでにHTML・CSSの基礎を学び、実案件または実案件に近い制作に取り組んでいる方を主な対象としています。
			</p>
			<ul class="list-plain plus-who__list">
				{whoItsFor.map((t) => <li>{t}</li>)}
			</ul>
		</div>
	</section>

	<section class="section plus-not-for">
		<div class="container">
			<SectionHeading eyebrow="BEFORE YOU JOIN">参加前に知っておいてほしいこと。</SectionHeading>
			<div class="plus-not-for__body">
				<p>maroriri Plusは、これから初めてHTML・CSSを学ぶための初心者向けスクールではありません。</p>
				<p>また、質問に対してすぐに正解だけをお渡しする場所でもありません。</p>
				<p>
					「どうすればいいですか？」だけではなく、「私はこう考えたけれど、どう思いますか？」と、自分でも一度考えてみる。
				</p>
				<p>そのうえで、一緒に考えたり、別の視点を知ったりすることを大切にしています。</p>
				<p>職種を変えることや、短期間で仕事・収入を増やすことを目的としたサービスでもありません。</p>
				<p>今ある経験を土台に、できること、考えられることを少しずつ増やしていく場所です。</p>
			</div>
		</div>
	</section>

	<section class="section section--white plus-price">
		<div class="container">
			<SectionHeading eyebrow="PRICE & WHAT'S INCLUDED">料金と、含まれる内容</SectionHeading>
			<div class="plus-price__wrap">
				<PriceBlock items={[{ label: "月額料金", value: coderClub.monthlyFee }]} />
			</div>

			<p class="plus-price__included-lead">月額料金には、以下が含まれます。</p>
			<ul class="list-plain plus-price__included">
				{included.map((t) => <li>{t.title}</li>)}
			</ul>

			<div class="plus-price__excluded">
				<p class="plus-compare__heading">Plus会員特典</p>
				<p>案件チェックを会員価格で利用できます。</p>
				<div class="plus-price__addon-block">
					<PriceBlock
						items={[
							{ label: "一般価格", value: `${caseCheck.priceGeneral} ／ ${caseCheck.unit}` },
							{ label: "maroriri Plus会員", value: `${caseCheck.priceMember} ／ ${caseCheck.unit}` },
						]}
						note="案件の規模や確認範囲によって、別途ご案内する場合があります。"
					/>
				</div>
			</div>

			<div class="plus-price__excluded">
				<p class="plus-compare__heading">必要なときだけ利用できる個別相談</p>
				<p>
					「実務・キャリア相談」は、事前予約制・{consulting.duration}
					{consulting.price}の個別相談です。
				</p>
				<p>実際の案件、クライアント対応、見積もり、進行、これからの働き方などについて、1対1でじっくり整理したいときにご利用いただけます。</p>
				<p>こちらは月額料金には含まれません。</p>
				<ArrowLink href="/consulting/">実務・キャリア相談について見る</ArrowLink>
			</div>

			<div class="plus-compare">
				<p class="plus-compare__heading">「軽い実務相談」と「実務・キャリア相談」の違い</p>
				<div class="plus-compare__grid">
					<div class="plus-compare__col">
						<p class="plus-compare__label num-mono">コミュニティ内での軽い実務相談</p>
						<ul class="list-plain">
							{lightConsult.map((t) => <li>{t}</li>)}
						</ul>
					</div>
					<div class="plus-compare__col plus-compare__col--accent">
						<p class="plus-compare__label num-mono plus-compare__label--accent">実務・キャリア相談</p>
						<ul class="list-plain">
							{bookedConsult.map((t) => <li>{t}</li>)}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section plus-flow">
		<div class="container">
			<SectionHeading eyebrow="HOW TO JOIN">参加までの流れ</SectionHeading>
			<p class="plus-flow__lead">公式LINEから、次の手順でご参加いただけます。</p>
			<div class="plus-flow__wrap">
				<ServiceFlow steps={flowSteps} />
			</div>
			<p class="plus-flow__note">公式LINEで「プラス」と送ってください。</p>
		</div>
	</section>

	<section class="section section--white plus-founder">
		<div class="container">
			<SectionHeading eyebrow="FROM THE FIELD">制作の現場で、<br />領域を広げてきた35年。</SectionHeading>
			<div class="plus-founder__body">
				<p>私自身も、最初から提案やディレクションができたわけではありません。</p>
				<p>
					DTPからWeb制作へ。コーディング、WordPressの構築・運用、進行管理、クライアント対応、ディレクション、そして制作者の育成へ。
				</p>
				<p>目の前の仕事に必要なことを一つずつ覚えながら、少しずつ仕事の領域を広げてきました。</p>
				<p>「コーダーだから、ここまで」ではなく、コーディングを土台に、その先へ進むことはできます。</p>
				<p>MARORIRIで大切にしているのは、私のやり方をそのまま覚えてもらうことではありません。</p>
				<p class="plus-founder__value">あなたが自分で考えたものに、私がこれまで現場で経験してきたことをプラスする。</p>
				<p>その中から、自分なりの仕事の仕方を見つけてもらえたらと思っています。</p>
				<ArrowLink href="/profile/">運営者について詳しく見る</ArrowLink>
			</div>
		</div>
	</section>

	<section class="section plus-faq">
		<div class="container plus-faq__grid">
			<div class="plus-faq__head">
				<p class="eyebrow reveal-heading">FAQ</p>
				<h2 class="reveal-heading">maroriri Plusに<br />よくいただく質問。</h2>
				<ArrowLink href="/faq/">よくある質問をすべて見る</ArrowLink>
			</div>
			<div class="plus-faq__list">
				<FaqAccordion items={faqItems} />
			</div>
		</div>
	</section>

	<CTASection
		primaryLabel="公式LINEで「プラス」と送ってください。"
		primaryHref="/contact/#maroriri-plus"
		secondaryLabel="まずは個別に相談したい方へ"
		secondaryHref="/consulting/"
	>
		一人で歩く。<br />でも、独りではない。
		<Fragment slot="body">
			<p>仕事の中で迷ったとき、すぐに答えをもらうのではなく、一緒に考えられる場所がある。</p>
			<p>maroriri Plusが、自分で考え、自分で選んで仕事を続けていくためのひとつの場所になればと思っています。</p>
		</Fragment>
	</CTASection>
</BaseLayout>

<style>
	.hero-cta {
		margin-top: 32px;
		margin-bottom: 40px;
	}

	.hero-sub {
		margin-top: 4px;
		opacity: 0.85;
	}

	.plus-concerns__lead {
		margin-top: 32px;
	}

	.plus-concerns__list {
		margin-top: 40px;
		display: flex;
		flex-wrap: wrap;
		gap: 20px 24px;
		max-width: none;
	}

	.plus-concerns__list li {
		flex: 1 1 260px;
		max-width: 340px;
		padding: 20px 22px;
		background: var(--color-highlight);
		color: var(--color-text);
		border-radius: var(--radius-sm);
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.plus-concerns__list li::before {
		content: none;
	}

	.plus-concerns__list li:nth-child(3n + 1) {
		transform: rotate(-1.5deg);
	}

	.plus-concerns__list li:nth-child(3n + 2) {
		transform: rotate(1deg);
	}

	.plus-concerns__list li:nth-child(3n + 3) {
		transform: rotate(-0.5deg);
	}

	.plus-about__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.plus-get__wrap {
		margin-top: 40px;
	}

	.plus-get__note {
		margin-top: 24px;
		font-size: 0.9rem;
		opacity: 0.7;
		max-width: 36em;
	}

	.plus-themes__lead {
		margin-top: 32px;
		max-width: 38em;
	}

	.plus-themes__list {
		margin-top: 40px;
		display: flex;
		flex-direction: column;
	}

	.plus-themes__list li {
		padding-block: 24px;
		border-top: 1px solid var(--color-border);
	}

	.plus-themes__list li:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.plus-themes__list h3 {
		font-size: 1.05rem;
		font-weight: 500;
	}

	.plus-themes__list p {
		margin-top: 10px;
		opacity: 0.85;
		max-width: 38em;
	}

	.plus-change__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.plus-who__lead {
		margin-top: 32px;
		max-width: 38em;
	}

	.plus-who__list {
		margin-top: 24px;
	}

	.plus-not-for__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.plus-price__wrap {
		margin-top: 32px;
		max-width: 24em;
	}

	.plus-price__included-lead {
		margin-top: 40px;
	}

	.plus-price__included {
		margin-top: 16px;
	}

	.plus-price__excluded {
		margin-top: 40px;
		padding: 24px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		max-width: 34em;
	}

	.plus-price__excluded p {
		margin-top: 14px;
		opacity: 0.85;
	}

	.plus-price__excluded :global(.arrow-link) {
		margin-top: 18px;
	}

	.plus-price__addon-block {
		margin-top: 20px;
	}

	.plus-compare {
		margin-top: 56px;
	}

	.plus-compare__heading {
		font-size: clamp(1.1rem, 1rem + 0.6vw, 1.3rem);
		font-weight: 500;
	}

	.plus-compare__grid {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.plus-compare__col {
		padding-top: 20px;
		border-top: 1px solid var(--color-border);
	}

	.plus-compare__label {
		font-size: 0.85rem;
		opacity: 0.55;
	}

	.plus-compare__label--accent {
		color: var(--color-accent);
		opacity: 1;
	}

	.plus-compare__col ul {
		margin-top: 20px;
	}

	.plus-flow__lead {
		margin-top: 32px;
	}

	.plus-flow__wrap {
		margin-top: 40px;
	}

	.plus-flow__note {
		margin-top: 24px;
		font-size: 0.9rem;
		opacity: 0.7;
	}

	.plus-founder__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.plus-founder__value {
		margin-top: 8px;
		font-weight: 500;
	}

	.plus-founder__body :global(.arrow-link) {
		margin-top: 12px;
	}

	.plus-faq__grid {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

