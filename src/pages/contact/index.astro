---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ServiceFlow from "../../components/ServiceFlow.astro";
import LineContactBlock from "../../components/LineContactBlock.astro";
import ArrowLink from "../../components/ArrowLink.astro";

const canTalk = [
	"maroririプラスへの参加",
	"案件チェックの申込み",
	"単発個別相談の申込み",
	"サービスについての質問",
	"どのサービスが合うか分からない場合の相談",
];

const flowSteps = [
	{ num: "01", title: "公式LINEを友だち追加" },
	{ num: "02", title: "希望するサービス名を送信" },
	{ num: "03", title: "現在の状況を分かる範囲で送信" },
	{ num: "04", title: "内容を確認後、必要事項をご案内" },
	{ num: "05", title: "日程や申込み方法を調整" },
];

const examples = [
	{ id: "maroriri-plus", label: "maroririプラス", text: "maroririプラスについて知りたいです" },
	{ id: "case-check", label: "案件チェック", text: "案件チェックを希望します" },
	{ id: "consulting", label: "個別相談", text: "個別相談を希望します" },
	{ id: "other", label: "その他", text: "どのサービスが合うか相談したいです" },
];
---

<BaseLayout title="相談・申込み｜MARORIRI" description="MARORIRIのmaroririプラス、案件チェック、単発個別相談への申込みやご質問は、公式LINEから受け付けています。">
	<PageHero eyebrow="CONTACT" crumbLabel="相談・申込み">
		相談・申込みは、<br />公式LINEから受け付けています。
		<Fragment slot="lede">
			<p>
				maroririプラス、案件チェック、単発個別相談への<br />
				申込みやご質問を、公式LINEから受け付けています。
			</p>
			<p>
				内容が整理できていない段階でも構いません。<br />
				現在困っていることや、気になっているサービスを分かる範囲でお送りください。
			</p>
		</Fragment>
	</PageHero>

	<section class="section section--white contact-line">
		<div class="container">
			<SectionHeading eyebrow="OFFICIAL LINE">友だち追加後、<br />ご希望のサービス名をお送りください。</SectionHeading>
			<div class="contact-line__wrap">
				<LineContactBlock />
			</div>
		</div>
	</section>

	<section class="section contact-topics">
		<div class="container">
			<p class="eyebrow reveal-heading">WHAT YOU CAN TALK ABOUT</p>
			<h2 class="contact-topics__heading reveal-heading">相談できる内容</h2>
			<ul class="list-plain contact-topics__list">
				{canTalk.map((t) => <li>{t}</li>)}
			</ul>
		</div>
	</section>

	<section class="section section--white contact-flow">
		<div class="container">
			<p class="eyebrow reveal-heading">AFTER YOU ADD US</p>
			<h2 class="contact-flow__heading reveal-heading">友だち追加後の流れ</h2>
			<div class="contact-flow__wrap">
				<ServiceFlow steps={flowSteps} />
			</div>
		</div>
	</section>

	<section class="section contact-examples">
		<div class="container">
			<p class="eyebrow reveal-heading">MESSAGE EXAMPLES</p>
			<h2 class="contact-examples__heading reveal-heading">サービス別の送信例</h2>
			<ul class="contact-examples__list">
				{
					examples.map((e) => (
						<li id={e.id} class="contact-examples__item">
							<span class="contact-examples__label num-mono">{e.label}</span>
							<p class="contact-examples__text">「{e.text}」</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section section--white contact-caution">
		<div class="container">
			<SectionHeading eyebrow="ABOUT CLIENT PROJECTS">クライアント案件について<br />相談する場合</SectionHeading>
			<div class="contact-caution__body">
				<p>案件チェックや個別相談では、クライアント案件について相談することもできます。</p>
				<p>ただし、クライアント名、個人情報、ログイン情報、未公開データなどを最初からLINEへ送信しないでください。</p>
				<p>まずは案件の概要と確認してほしい内容をお送りください。必要な資料や共有方法は、内容を確認した後にご案内します。</p>
			</div>
		</div>
	</section>

	<section class="section contact-other">
		<div class="container">
			<p class="eyebrow reveal-heading">OTHER CONTACT</p>
			<h2 class="contact-other__heading reveal-heading">LINE以外の連絡先</h2>
			<p class="contact-other__body">
				公式LINEを主な窓口としています。利用規約、特定商取引法に基づく表記、プライバシーポリシーには、必要に応じて正式なメールアドレスを掲載します。
			</p>
		</div>
	</section>

	<section class="section section--dark contact-faq">
		<div class="container contact-faq__inner">
			<h2 class="contact-faq__heading reveal-heading">掲載されていない内容については、<br />よくある質問もご確認ください。</h2>
			<ArrowLink href="/faq/" class="contact-faq__link">よくある質問を見る</ArrowLink>
		</div>
	</section>
</BaseLayout>

<style>
	.contact-line__wrap {
		margin-top: 40px;
	}

	.contact-topics__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.contact-topics__list {
		margin-top: 32px;
	}

	.contact-flow__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.contact-flow__wrap {
		margin-top: 40px;
	}

	.contact-examples__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.contact-examples__list {
		margin-top: 40px;
		display: flex;
		flex-direction: column;
	}

	.contact-examples__item {
		padding-block: 24px;
		border-top: 1px solid var(--color-border);
		scroll-margin-top: 100px;
	}

	.contact-examples__item:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.contact-examples__label {
		color: var(--color-accent);
		font-size: 0.8rem;
	}

	.contact-examples__text {
		margin-top: 10px;
		font-size: 1.1rem;
	}

	.contact-caution__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.contact-other__heading {
		margin-top: 16px;
		font-size: clamp(1.4rem, 1.15rem + 1.6vw, 2rem);
	}

	.contact-other__body {
		margin-top: 24px;
		max-width: 38em;
		opacity: 0.8;
	}

	.contact-faq__inner {
		text-align: left;
	}

	.contact-faq__heading {
		font-size: clamp(1.4rem, 1.15rem + 1.8vw, 2.1rem);
	}

	.contact-faq__link {
		margin-top: 28px;
		color: var(--color-highlight);
	}

	@media (min-width: 768px) {
		.contact-examples__list {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.contact-examples__item {
			flex: 0 0 50%;
			padding-right: 24px;
		}
	}
</style>
