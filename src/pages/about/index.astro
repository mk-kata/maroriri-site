---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import CTASection from "../../components/CTASection.astro";

const perspectives = [
	{
		num: "01",
		tag: "STRUCTURE",
		title: "HTMLとデザインを読む",
		body: "見た目を再現するだけではなく、文章構造や情報の優先順位から考えます。",
	},
	{
		num: "02",
		tag: "PRACTICE",
		title: "実案件を進める",
		body: "工数、納期、確認、修正、クライアントとのやり取りを考えます。",
	},
	{
		num: "03",
		tag: "VALUE",
		title: "仕事とキャリアをつくる",
		body: "自分の価値、仕事の選び方、これからの働き方を考えます。",
	},
];

const forCreators = [
	"デザインをどうHTMLにすればいいのか迷う",
	"コードは書けるけれど、これでいいのか自信がない",
	"工数や修正範囲をどう伝えればいいのか分からない",
	"クライアントとのやり取りに迷う",
	"自分の強みをうまく言葉にできない",
	"AIが当たり前になる中で、これから何を身につければいいのか分からない",
];

const services = [
	{
		num: "01",
		en: "maroriri Plus",
		title: "maroriri Plus",
		body: "実務の疑問や迷いを持ち寄り、判断の基準を育てる月額制のコミュニティ。MARORIRIの中心となる場です。",
		href: "/maroriri-plus/",
	},
	{
		num: "02",
		en: "CASE CHECK",
		title: "案件チェック",
		body: "制作した案件を、構造・再現・表示・操作性の視点から確認し、次に活かせる考え方までお伝えします。",
		href: "/case-check/",
	},
	{
		num: "03",
		en: "1ON1 CONSULTING",
		title: "単発個別相談",
		body: "案件の進め方やキャリアなど、いま相談したいことを個別に整理します。",
		href: "/consulting/",
	},
];
---

<BaseLayout title="MARORIRIとは｜MARORIRI" description="MARORIRIは、コーダー・Web制作者が、制作現場で自分なりの基準を持って考え、選び、説明できるようになるための場所です。">
	<PageHero eyebrow="ABOUT MARORIRI" crumbLabel="MARORIRIとは">
		コードの書き方ではなく、<br />制作者としての考え方を育てる。
		<Fragment slot="lede">
			<p>
				MARORIRIは、コーダー・Web制作者が、<br />
				制作現場で自分なりの基準を持って<br />
				考え、選び、説明できるようになるための場所です。
			</p>
			<p>
				エラーの解決方法やコードの書き方だけではなく、<br />
				そのコードを書く理由、デザインの読み取り方、<br />
				仕事の進め方やクライアントとの関係まで扱います。
			</p>
		</Fragment>
	</PageHero>

	<section class="section section--white about-for">
		<div class="container">
			<SectionHeading eyebrow="FOR CREATORS">こんな迷いを持つ制作者へ。</SectionHeading>
			<ul class="list-plain about-for__list">
				{forCreators.map((t) => <li>{t}</li>)}
			</ul>
		</div>
	</section>

	<section class="section about-values">
		<div class="container">
			<SectionHeading eyebrow="WHAT WE VALUE">コードを書く力だけでなく、<br />仕事を自分で進める力を。</SectionHeading>
			<div class="about-values__body">
				<p>コードの書き方やエラーの解決方法は、検索したりAIに聞いたりすれば、以前よりずっと見つけやすくなりました。</p>
				<p>でも実際の制作では、答えがひとつではないことがたくさんあります。</p>
				<p>
					どんな構造で組むのか。<br />
					どこまで対応するのか。<br />
					どう伝えるのか。<br />
					どの仕事を選ぶのか。
				</p>
				<p>MARORIRIでは、そんな場面で自分なりに考え、判断できる力を育てていきます。</p>
			</div>
		</div>
	</section>

	<section class="section section--white about-perspectives">
		<div class="container">
			<SectionHeading eyebrow="THREE PERSPECTIVES">技術・実務・キャリア。<br />3つの視点から考えます。</SectionHeading>
			<ul class="about-perspectives__list">
				{
					perspectives.map((p) => (
						<li class="about-perspectives__item">
							<div class="about-perspectives__meta">
								<span class="num-mono">{p.num}</span>
								<span class="eyebrow">{p.tag}</span>
							</div>
							<div>
								<h3>{p.title}</h3>
								<p>{p.body}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section about-learn">
		<div class="container">
			<SectionHeading eyebrow="LEARN WITH MARORIRI">実務で身につけた考え方を、<br />講座や相談を通して。</SectionHeading>
			<div class="about-learn__body">
				<p>
					MARORIRIでは、「コーディングマインド講座」や<br />
					「コーダーによるデザイン料理教室」など、<br />
					実務の中で必要になる考え方をテーマにした講座を開催しています。
				</p>
				<p>答えをそのまま覚えるのではなく、なぜそう考えるのかを一緒に掘り下げていきます。</p>
				<ArrowLink href="/#courses">講座・活動実績を見る</ArrowLink>
			</div>
		</div>
	</section>

	<section class="section section--white about-services">
		<div class="container">
			<p class="eyebrow reveal-heading">MARORIRI SERVICES</p>
			<ol class="about-services__list">
				{
					services.map((s) => (
						<li class="about-services__item">
							<span class="num-mono about-services__num">{s.num}</span>
							<div class="about-services__content">
								<p class="about-services__en num-mono">{s.en}</p>
								<h3>{s.title}</h3>
								<p class="about-services__body">{s.body}</p>
								<ArrowLink href={s.href}>詳しく見る</ArrowLink>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<CTASection
		primaryLabel="maroriri Plusを見る"
		primaryHref="/maroriri-plus/"
		secondaryLabel="公式LINEで相談する"
		secondaryHref="/contact/"
	>
		自分の判断基準を、<br />仕事の中で育てていく。
	</CTASection>
</BaseLayout>

<style>
	.about-for__list {
		margin-top: 40px;
	}

	.about-values__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.about-perspectives__list {
		margin-top: 48px;
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	.about-perspectives__item {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding-top: 28px;
		border-top: 1px solid var(--color-border);
	}

	.about-perspectives__meta {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.about-perspectives__meta .num-mono {
		color: var(--color-border);
		font-size: 1.3rem;
	}

	.about-perspectives__item h3 {
		font-size: clamp(1.2rem, 1.05rem + 0.8vw, 1.5rem);
	}

	.about-perspectives__item p {
		margin-top: 12px;
		max-width: 34em;
		opacity: 0.85;
	}

	.about-learn__body {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 38em;
	}

	.about-learn__body :global(.arrow-link) {
		margin-top: 12px;
	}

	.about-services__list {
		margin-top: 40px;
		display: flex;
		flex-direction: column;
	}

	.about-services__item {
		display: flex;
		gap: 24px;
		padding-block: 32px;
		border-top: 1px solid var(--color-border);
	}

	.about-services__item:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.about-services__num {
		flex-shrink: 0;
		color: var(--color-border);
		font-size: 1.6rem;
	}

	.about-services__en {
		font-size: 0.78rem;
		color: var(--color-accent);
	}

	.about-services__content h3 {
		margin-top: 8px;
		font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem);
	}

	.about-services__body {
		margin-top: 10px;
		max-width: 34em;
		opacity: 0.8;
	}

	.about-services__content :global(.arrow-link) {
		margin-top: 18px;
	}

	@media (min-width: 1024px) {
		.about-perspectives__item {
			flex-direction: row;
			gap: 48px;
		}

		.about-perspectives__meta {
			flex: 0 0 220px;
		}
	}
</style>
