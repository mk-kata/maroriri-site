---
interface Props {
	href: string;
	class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class:list={["arrow-link", className]}>
	<span class="arrow-link__label"><slot /></span>
	<span class="arrow-link__arrow" aria-hidden="true">→</span>
</a>

<style>
	.arrow-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		letter-spacing: 0.02em;
		padding-block: 4px;
		border-bottom: 1px solid currentColor;
	}

	.arrow-link__arrow {
		display: inline-block;
	}

	@media (prefers-reduced-motion: no-preference) {
		.arrow-link__arrow {
			transition: transform 0.2s ease;
		}
	}

	.arrow-link:hover .arrow-link__arrow,
	.arrow-link:focus-visible .arrow-link__arrow {
		transform: translateX(4px);
	}
</style>
