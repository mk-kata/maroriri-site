---
import ArrowLink from "./ArrowLink.astro";
import { withBase } from "../utils/url";

interface Props {
	enCopy?: string;
	primaryLabel: string;
	primaryHref: string;
	secondaryLabel?: string;
	secondaryHref?: string;
}

const { enCopy, primaryLabel, primaryHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="cta-section section section--dark">
	<div class="container">
		{enCopy && <p class="cta-section__en reveal-heading">{enCopy}</p>}
		<h2 class="cta-section__heading reveal-heading"><slot /></h2>
		<div class="cta-section__body">
			<slot name="body" />
		</div>
		<div class="cta-section__actions">
			<a href={withBase(primaryHref)} class="btn btn--primary">{primaryLabel}</a>
			{
				secondaryLabel && secondaryHref && (
					<ArrowLink href={secondaryHref} class="cta-section__secondary">
						{secondaryLabel}
					</ArrowLink>
				)
			}
		</div>
	</div>
</section>

<style>
	.cta-section__en {
		font-family: var(--font-en);
		font-weight: 700;
		font-size: clamp(1rem, 0.85rem + 1vw, 1.4rem);
	}

	.cta-section__heading {
		margin-top: 20px;
		font-size: clamp(1.6rem, 1.2rem + 2.4vw, 2.4rem);
	}

	.cta-section__body {
		margin-top: 24px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		max-width: 34em;
		opacity: 0.8;
	}

	.cta-section__actions {
		margin-top: 36px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 24px;
	}

	.cta-section__actions :global(.cta-section__secondary) {
		color: var(--color-highlight);
	}
</style>
