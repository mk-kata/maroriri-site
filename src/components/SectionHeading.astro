---
interface Props {
	eyebrow: string;
	class?: string;
}

const { eyebrow, class: className } = Astro.props;
---

<div class:list={["section-heading", className]}>
	<p class="eyebrow reveal-heading">{eyebrow}</p>
	<h2 class="section-heading__title reveal-heading"><slot /></h2>
</div>

<style>
	.section-heading__title {
		margin-top: 16px;
		font-size: clamp(1.5rem, 1.2rem + 2vw, 2.2rem);
	}
</style>
