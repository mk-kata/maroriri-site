---
import PageHero from "./PageHero.astro";

interface Props {
	eyebrow: string;
	crumbLabel: string;
	title: string;
	lede?: string;
}

const { eyebrow, crumbLabel, title, lede } = Astro.props;
---

<PageHero eyebrow={eyebrow} crumbLabel={crumbLabel}>
	{title}
	<Fragment slot="lede">
		{lede && <p>{lede}</p>}
		<p class="legal-pending-notice">正式な運用条件は公開前に確定します。</p>
	</Fragment>
</PageHero>

<div class="legal-content section">
	<div class="container">
		<slot />
	</div>
</div>

<style>
	.legal-pending-notice {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-accent);
	}
</style>
