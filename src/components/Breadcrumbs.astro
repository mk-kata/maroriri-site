---
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="パンくずリスト">
	<ol>
		<li><a href="/">HOME</a></li>
		{
			items.map((item) => (
				<li>
					<span class="breadcrumbs__sep" aria-hidden="true">
						/
					</span>
					{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
				</li>
			))
		}
	</ol>
</nav>

<style>
	.breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.03em;
		opacity: 0.6;
	}

	.breadcrumbs li {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.breadcrumbs a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.breadcrumbs__sep {
		opacity: 0.5;
	}
</style>
